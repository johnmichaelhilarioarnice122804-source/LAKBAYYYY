# Copy to .env.local and fill in real values. Never commit .env.local.
# On a physical Android device, localhost is the device itself, not your PC.
# Use your PC's LAN IP (for example http://192.168.1.10:8000/api) in that case.
VITE_API_BASE_URL=http://localhost:8000/api
# Map tiles come from OpenStreetMap; no map API key is required.

# Real road routing is ON by default so the itinerary map follows roads between
# stops. Set VITE_ROUTING_PROVIDER=none to disable it and keep the dashed visual
# sequence link only (no request is made when disabled).
# Supported value: osrm (default). VITE_ROUTING_BASE_URL overrides the default
# https://router.project-osrm.org.
#
# T-919 / MAP §14 RELEASE BLOCKER: the public OSRM demo server
# (router.project-osrm.org) is for DEVELOPMENT ONLY. It has no SLA and is not
# intended for sustained production traffic. Before release, point
# VITE_ROUTING_BASE_URL at a self-hosted OSRM instance or a paid routing
# provider, and set VITE_ROUTING_PROVIDER/VITE_ROUTING_API_KEY accordingly.
VITE_ROUTING_PROVIDER=osrm
VITE_ROUTING_BASE_URL=https://router.project-osrm.org
# Only for a keyed routing provider. The public OSRM demo does not use it.
VITE_ROUTING_API_KEY=
